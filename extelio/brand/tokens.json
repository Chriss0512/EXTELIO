  },
  "color": {
    "brand": {
      "blue": { "value": "#2864DC", "usage": "Primary, CTA, aktive Navigation, Links" },
      "blueBright": { "value": "#3B82F6", "usage": "Hover, Focus, aktive technische Zustände" },
