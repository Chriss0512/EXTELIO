    "borderWidth": "1px"
  },
  "controls": {
    "button": { "height": "38px", "radius": "8px", "weight": 600 },
    "input": { "height": "39px", "radius": "8px", "border": "#D0D5DD", "focus": "#2864DC" },
    "iconButton": { "size": "34px", "tooltip": "required" }
