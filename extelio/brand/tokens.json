      "graphite": { "value": "#232934", "usage": "Dark Surfaces" },
      "slate": { "value": "#667085", "usage": "Sekundärtext, Metadaten" },
      "border": { "value": "#E4E7EC", "usage": "Border, Divider, Tabellen" },
      "canvas": { "value": "#F6F7F9", "usage": "Light Background" },
      "surface": { "value": "#FFFFFF", "usage": "Panels, Karten, Tabellen" }
    },
    "status": {
      "success": { "value": "#22C55E", "usage": "Success / Online" },
      "warning": { "value": "#F59E0B", "usage": "Warning / Degraded" },
      "critical": { "value": "#EF4444", "usage": "Critical / Offline" },
      "info": { "value": "#3B82F6", "usage": "Info" }
    },
    "light": {
      "background": { "value": "#F6F7F9" },
      "surface": { "value": "#FFFFFF" },
      "textPrimary": { "value": "#111827" },
      "textSecondary": { "value": "#667085" },
      "border": { "value": "#E4E7EC" },
      "accent": { "value": "#2864DC" }
    },
    "dark": {
      "background": { "value": "#111827" },
      "surface": { "value": "#232934" },
      "surfaceSecondary": { "value": "#2D3440" },
      "textPrimary": { "value": "#F9FAFB" },
      "textSecondary": { "value": "#98A2B3" },
      "border": { "value": "#374151" },
      "accent": { "value": "#3B82F6" }
    }
  },
  "typography": {
    "fontFamily": { "preferred": "Inter", "alternative": "Geist" },
    "scale": {
      "pageTitle": { "size": "26px", "weight": 600 },
      "sectionTitle": { "size": "19px", "weight": 600 },
      "panelTitle": { "size": "15px", "weight": 600 },
      "body": { "size": "14px", "weight": 400 },
      "table": { "size": "13.5px", "weight": 400 },
      "metadata": { "size": "12px", "weight": 400 },
      "button": { "size": "13.5px", "weight": 600 }
