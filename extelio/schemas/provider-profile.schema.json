{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://extelio.local/schemas/provider-profile.schema.json",
  "title": "EXTELIO Provider Profile",
  "description": "Anbieterprofil (Kapitel 8.3, 10.1).",
  "type": "object",
  "required": ["key", "name", "transport", "codecs", "number_format", "auth_capabilities"],
  "additionalProperties": false,
  "properties": {
    "key": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "registrar": { "type": ["string", "null"] },
    "proxy": { "type": ["string", "null"] },
    "transport": { "enum": ["udp", "tcp", "tls"] },
    "codecs": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["OPUS", "PCMA", "PCMU", "G722"] }
    },
    "number_format": { "enum": ["e164", "national", "provider_specific"] },
    "auth_capabilities": {
      "type": "array",
      "items": { "enum": ["register", "digest", "ip_auth"] }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "srtp": { "type": "boolean" },
        "early_media": { "type": "boolean" },
        "clip_no_screening": { "type": "boolean" }
      }
    }
  }
}
